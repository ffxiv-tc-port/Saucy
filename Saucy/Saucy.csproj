<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <!-- Bumps a persisted build counter on every build and folds it into the assembly version's
         4th component, so each local build gets a distinct, easily-identifiable version number
         (shown in-game via TitleBarVersion.cs). Computed here at evaluation time (not inside a
         Target) because Dalamud.NET.Sdk's own targets also stamp AssemblyVersion/FileVersion (from
         git) in a target that runs AFTER any target-based override here, silently discarding it —
         confirmed live: the compiled DLL kept showing 2.1.1.0 no matter what a BumpBuildNumber
         Target set. Setting these as plain evaluated properties, before Sdk.targets is imported,
         wins instead of racing it. -->
    <PropertyGroup>
        <Authors>Puni.sh</Authors>
        <BuildNumberFile>$(MSBuildProjectDirectory)\BuildNumber.txt</BuildNumberFile>
        <_PreviousBuildNumber Condition="Exists('$(BuildNumberFile)')">$([System.IO.File]::ReadAllText('$(BuildNumberFile)').Trim())</_PreviousBuildNumber>
        <_PreviousBuildNumber Condition="'$(_PreviousBuildNumber)' == ''">0</_PreviousBuildNumber>
        <BuildNumber>$([MSBuild]::Add($(_PreviousBuildNumber), 1))</BuildNumber>
        <VersionPrefix>7.15.0</VersionPrefix>
        <Version>$(VersionPrefix).$(BuildNumber)</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net9.0-windows</TargetFramework>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <!-- Persists the incremented counter for next build. Timing doesn't matter here (unlike the
         version properties above) since this only needs to be on disk before the NEXT invocation. -->
    <Target Name="PersistBuildNumber" AfterTargets="Build">
        <WriteLinesToFile File="$(BuildNumberFile)" Lines="$(BuildNumber)" Overwrite="true"/>
    </Target>

    <!-- Apply .editorconfig code-style (IDE*) and analyzers on Debug builds and when CI=true. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(CI)' == 'true'">
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    </PropertyGroup>

    <PropertyGroup>
        <DalamudLibPath>$(DALAMUD_HOME)/</DalamudLibPath>
    </PropertyGroup>

    <ItemGroup>
        <!-- ECommons 走本 org 的 fork 子模組(BaseVersion 仍是 3.0.1.15,只換來源不換版本號)。
             上游 NuGet 3.0.1.15 的 AddonMaster/ClickHelper 沒有 OwnerNode 判空,而 Saucy 是全艦隊
             唯一真的呼叫那段碼的未加固出貨者(AddonMaster 12 處 + ClickHelper),所以必須吃 fork。
             🔴 這裡是 ProjectReference 而不是 PackageReference:PunishLib 遞移宣告的
             ECommons NuGet 3.0.1.10(未加固)會被這個 ProjectReference 蓋掉
             (Artisan/AutoRetainer/Avarice/WrathCombo 四個 repo 已出貨證實同樣組態)。
             ⚠️ 不要把 PackageReference 加回來共存——「兩者並存時 project 一定贏」沒有證據。 -->
        <ProjectReference Include="..\ECommons\ECommons\ECommons.csproj"/>
        <PackageReference Include="NAudio" Version="2.3.0"/>
        <PackageReference Include="NAudio.Lame" Version="2.1.0"/>
        <ProjectReference Include="..\PunishLib\PunishLib\PunishLib.csproj"/>
        <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.2"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="LanguageChineseTraditional.ini">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <None Update="Saucy.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="Icon.png" Link="images\icon.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="Sounds\Game Over.mp3">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="Sounds\Moogle.mp3">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="Sounds\Time Up.mp3">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>

